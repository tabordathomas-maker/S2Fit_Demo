# ===== Backend S2 Fit Evolution (FastAPI) =====
# Copia este archivo como backend/.env para desarrollo local.
# En producción, configura estas variables en Render (Environment). NUNCA las subas a GitHub.

# development | test | production  (en production se ocultan /docs y /openapi.json)
ENVIRONMENT=development

# PostgreSQL. Local: el clúster de desarrollo. Producción: "Session pooler" de Supabase
# (Project Settings > Database > Connection string > Session pooler), compatible con IPv4.
DATABASE_URL=postgresql+psycopg://postgres@localhost:54329/s2fit

# Supabase Auth: URL del proyecto (verifica tokens firmados con claves asimétricas vía JWKS
# y comprueba el emisor) y, si tu proyecto usa el secreto JWT heredado (HS256), ese secreto.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Solo backend: permite subir imágenes de productos a Supabase Storage. SECRETO.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Orígenes permitidos (sin barra final), separados por comas.
# Producción: https://TU-USUARIO.github.io
CORS_ORIGINS=http://localhost:5173

# Minutos que se mantienen apartadas las prendas de un pedido pendiente (2880 = 48 h).
RESERVATION_TTL_MINUTES=2880

# Solicitudes por usuario y minuto en endpoints sensibles (crear pedido / solicitud).
RATE_LIMIT_PER_MINUTE=10

APP_TIMEZONE=America/Bogota

# Solo para pytest: base aislada cuyo nombre DEBE terminar en _test.
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:54329/s2fit_test
