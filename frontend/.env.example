# ===== Frontend S2 Fit Evolution (Vite) =====
# Copia este archivo como frontend/.env.local para desarrollo.
# ATENCIÓN: todas las variables VITE_* quedan dentro del sitio público. Nunca pongas secretos aquí
# (ni la clave service_role de Supabase, ni contraseñas).

# URL de la API (local: http://localhost:8000 · producción: https://TU-SERVICIO.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Supabase: URL del proyecto y clave pública (anon / publishable).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Número comercial de WhatsApp, formato internacional SOLO dígitos (ej. 57 + número). No inventar.
VITE_WHATSAPP_BUSINESS_NUMBER=

# Ruta base del sitio: "/" para usuario.github.io; "/nombre-repositorio/" para sitios de proyecto.
# En GitHub Actions se calcula sola.
VITE_BASE_PATH=/
